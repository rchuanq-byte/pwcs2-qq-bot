#!/usr/bin/env bash
set -Eeuo pipefail

STATE_DIR="${IWAN_WATCHDOG_STATE_DIR:-/run/qqbot-iwan-watchdog}"
FAILURE_THRESHOLD="${IWAN_WATCHDOG_FAILURE_THRESHOLD:-3}"
COOLDOWN_SECONDS="${IWAN_WATCHDOG_COOLDOWN_SECONDS:-1800}"
RESTART_TIMEOUT_SECONDS="${IWAN_WATCHDOG_RESTART_TIMEOUT_SECONDS:-45}"
LOCK_FILE="$STATE_DIR/lock"
FAILURE_FILE="$STATE_DIR/consecutive_failures"
LAST_ATTEMPT_FILE="$STATE_DIR/last_attempt"

for value_name in FAILURE_THRESHOLD COOLDOWN_SECONDS RESTART_TIMEOUT_SECONDS; do
  value="${!value_name}"
  if ! [[ "$value" =~ ^[0-9]+$ ]]; then
    echo "Invalid $value_name: $value" >&2
    exit 2
  fi
  normalized="$((10#$value))"
  if ((normalized <= 0)); then
    echo "Invalid $value_name: $value" >&2
    exit 2
  fi
  printf -v "$value_name" '%d' "$normalized"
done
if ((FAILURE_THRESHOLD > 12)); then
  echo "IWAN_WATCHDOG_FAILURE_THRESHOLD cannot exceed 12." >&2
  exit 2
fi
if ((COOLDOWN_SECONDS < 60 || COOLDOWN_SECONDS > 86400)); then
  echo "IWAN_WATCHDOG_COOLDOWN_SECONDS must be between 60 and 86400." >&2
  exit 2
fi
if ((RESTART_TIMEOUT_SECONDS < 5 || RESTART_TIMEOUT_SECONDS > 60)); then
  echo "IWAN_WATCHDOG_RESTART_TIMEOUT_SECONDS must be between 5 and 60." >&2
  exit 2
fi

install -d -m 0755 "$STATE_DIR"
if ! command -v flock >/dev/null 2>&1; then
  echo "flock is required for the iWAN watchdog (install util-linux)." >&2
  exit 2
fi
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Another iWAN watchdog check is still running; skip this cycle."
  exit 0
fi

read -r -a URLS <<<"${IWAN_HEALTH_URLS:-https://api.llm.ustc.edu.cn/v1/models}"
if ((${#URLS[@]} == 0 || ${#URLS[@]} > 2)); then
  echo "IWAN_HEALTH_URLS must contain one or two space-separated URLs." >&2
  exit 2
fi
IFS=',' read -r -a PROXY_DOMAIN_VALUES <<<"${IWAN_PROXY_DOMAINS:-api.llm.ustc.edu.cn}"
if ((${#PROXY_DOMAIN_VALUES[@]} == 0 || ${#PROXY_DOMAIN_VALUES[@]} > 3)); then
  echo "IWAN_PROXY_DOMAINS must contain one to three comma-separated domains." >&2
  exit 2
fi

read_counter() {
  local path="$1" value=0
  if [[ -r "$path" ]]; then
    read -r value <"$path" || value=0
  fi
  [[ "$value" =~ ^[0-9]+$ ]] || value=0
  printf '%s\n' "$((10#$value))"
}

write_counter() {
  local path="$1" value="$2" temp
  temp="$(mktemp "$STATE_DIR/.counter.XXXXXX")"
  printf '%s\n' "$value" >"$temp"
  mv -fT "$temp" "$path"
}

check_routes() {
  local address domain found route tun
  tun="${IWAN_TUN:-iwan0}"
  for domain in "${PROXY_DOMAIN_VALUES[@]}"; do
    domain="${domain//[[:space:]]/}"
    [[ -n "$domain" ]] || continue
    found=false
    while read -r address; do
      [[ -n "$address" ]] || continue
      found=true
      route="$(ip route get "$address" 2>/dev/null || true)"
      [[ "$route" == *" dev $tun "* ]] || return 1
    done < <(timeout 5s getent ahostsv4 "$domain" | awk '{print $1}' | sort -u)
    "$found" || return 1
  done
}

monotonic_seconds() {
  local uptime ignored
  read -r uptime ignored </proc/uptime
  printf '%s\n' "${uptime%%.*}"
}

check_urls() {
  local code url
  check_routes || return 1
  for url in "${URLS[@]}"; do
    if ! code="$(
      curl -sS --connect-timeout 5 --max-time 10 \
        -o /dev/null -w '%{http_code}' "$url"
    )"; then
      return 1
    fi
    # Any real HTTP response proves DNS, routing, TCP and TLS are working. A
    # 429/5xx is an upstream service condition and must not restart the tunnel.
    [[ "$code" =~ ^[1-5][0-9][0-9]$ ]] || return 1
  done
}

if check_urls; then
  write_counter "$FAILURE_FILE" 0
  exit 0
fi
sleep 2
if check_urls; then
  write_counter "$FAILURE_FILE" 0
  exit 0
fi

failures="$(read_counter "$FAILURE_FILE")"
failures=$((failures + 1))
if ((failures > FAILURE_THRESHOLD)); then
  failures="$FAILURE_THRESHOLD"
fi
write_counter "$FAILURE_FILE" "$failures"
if ((failures < FAILURE_THRESHOLD)); then
  echo "iWAN health check failed ($failures/$FAILURE_THRESHOLD); waiting for another failed cycle before restarting."
  exit 0
fi

now="$(monotonic_seconds)"
last_attempt="$(read_counter "$LAST_ATTEMPT_FILE")"
elapsed=$((now - last_attempt))
if ((last_attempt > 0 && elapsed < COOLDOWN_SECONDS)); then
  remaining=$((COOLDOWN_SECONDS - elapsed))
  echo "iWAN remains unhealthy, but restart cooldown is active for another ${remaining}s."
  exit 0
fi

echo "iWAN failed $failures consecutive watchdog cycles; attempting one bounded restart."

if ! timeout --kill-after=5s "${RESTART_TIMEOUT_SECONDS}s" \
  systemctl restart qqbot-iwan.service; then
  echo "iWAN restart was not accepted within ${RESTART_TIMEOUT_SECONDS}s or failed; retry is allowed on the next timer cycle." >&2
  exit 1
fi

# Start the long cooldown only after systemd accepted and completed the restart.
# A start-limit rejection must be retried on each 5-minute timer cycle so it can
# recover as soon as systemd's own 30-minute start-limit window expires.
write_counter "$LAST_ATTEMPT_FILE" "$(monotonic_seconds)"

sleep 8
if ! check_urls; then
  echo "iWAN restart completed, but the health check is still failing; cooldown remains active." >&2
  exit 1
fi

write_counter "$FAILURE_FILE" 0
echo "iWAN recovered after a controlled restart."
