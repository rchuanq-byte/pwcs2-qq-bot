ARG LEGACY_IMAGE=pwcs2-qq-bot:local
FROM ${LEGACY_IMAGE} AS existing-browser
FROM m.daocloud.io/docker.io/soulter/astrbot@sha256:d6f6508af78b9d0e427c0959a2fdd1016411720aad67cfcde8719870a89ee832 AS astrbot-runtime

USER root
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/AstrBot/data/home
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
      fonts-liberation fonts-noto-core fonts-noto-color-emoji ffmpeg \
      libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 \
      libcairo2 libcups2t64 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 \
      libnspr4 libnss3 libpango-1.0-0 libx11-6 libx11-xcb1 libxcb1 \
      libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=existing-browser /opt/pw-browsers /opt/pw-browsers
COPY pyproject.toml README.md /opt/niuniu/
RUN python -m pip install --no-cache-dir --index-url https://mirrors.aliyun.com/pypi/simple/ \
      hatchling 'playwright==1.60.0' 'edge-tts==7.3.1'
COPY src /opt/niuniu/src
RUN python -m pip install --no-deps --no-build-isolation /opt/niuniu \
    && python -c "from pwcs2_bot.astrbot_transport import AstrBotCSApplication; import sys; assert not any(m.startswith('nanobot') for m in sys.modules)" \
    && groupadd -g 10001 niuniu && useradd -u 10001 -g 10001 -M niuniu
COPY vendor/dafeiyu /opt/niuniu-plugins/
COPY astrbot_plugins/astrbot_plugin_niuniu /opt/niuniu-plugins/astrbot_plugin_niuniu
COPY deploy/astrbot_bootstrap.py /opt/niuniu/astrbot_bootstrap.py
USER 10001:10001
WORKDIR /AstrBot
EXPOSE 6199 18790
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python -m pwcs2_bot.healthcheck || exit 1
CMD ["python", "/opt/niuniu/astrbot_bootstrap.py"]
