# Copy to .env and replace every CHANGE_ME value.
PERFECTWORLD_TOKEN=CHANGE_ME
# Optional: the SteamID64 bound to the Perfect World account that produced the token.
# If left blank, the bot sends the queried SteamID as both mySteamId and toSteamId.
PERFECTWORLD_MY_STEAM_ID=
# Official Steam Web API key. Configure with deploy/configure_steam.py.
STEAM_WEB_API_KEY=
# Optional private Mihomo/HTTP proxy used only by Steam presence requests.
STEAM_PRESENCE_PROXY_URL=
# deploy/configure_steam_proxy.py enables this profile after writing its secret config.
COMPOSE_PROFILES=
STEAM_MIHOMO_IMAGE=pwcs2-steam-mihomo:1.19.29
NAPCAT_ONEBOT_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_VALUE

# Demo-based CS2 highlight pipeline. Keep disabled until
# deploy/configure_highlights.py has written the PWA and worker credentials.
HIGHLIGHT_ENABLED=0
PWCS2_PWA_DEMO_ENABLED=0
PERFECTWORLD_PWA_ACCESS_TOKEN=
PWCS2_HIGHLIGHT_WORKER_SECRETS_JSON={}
PWCS2_HIGHLIGHT_DATA_DIR=/data/highlights
PWCS2_HIGHLIGHT_INTENT_DATABASE_PATH=/data/highlights/intents.db
PWCS2_HIGHLIGHT_MAX_VIDEO_BYTES=25165824
PWCS2_HIGHLIGHT_MAX_BACKLOG_DEMOS=2
PWCS2_HIGHLIGHT_MAX_BACKLOG_DEMO_BYTES=2147483648
# Bootstrap CS2 patch only; authenticated Windows worker reports override it.
PWCS2_HIGHLIGHT_RENDERER_PATCH=
HIGHLIGHT_CONTROLLER_MEMORY_LIMIT=768m
HIGHLIGHT_CONTROLLER_MEMORY_SWAP_LIMIT=1280m
PWCS2_HIGHLIGHT_IMAGE=pwcs2-qq-bot-highlight:local

# USTC OpenAI-compatible model service. Configure with deploy/configure_ai.py.
USTC_LLM_API_KEY=
# Private HTTP proxy with a campus-only rule; never set the whole host's proxy.
USTC_LLM_PROXY_URL=
USTC_LLM_MODEL=deepseek-flash
# Same model = native multimodal; different model = separate vision helper.
USTC_LLM_VISION_MODEL=deepseek-flash

# Linux host uid/gid owning the persisted NapCat files.
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_WEBUI_PORT=6099
NAPCAT_ACCOUNT=

# Optional operator and group-specific add-ons. Keep actual values in .env.
NIUNIU_OPERATOR_QQ=
NIUNIU_SCRIPTURE_GROUP_ID=
NIUNIU_SCRIPTURE_URL=
NIUNIU_XH_REACTION_IMAGE=

# Resource guardrails for small hosts. Upgrade the server to at least 4 GiB RAM
# before raising these values. Docker may use host swap within its normal limit.
BOT_MEMORY_LIMIT=800m
BOT_MEMORY_SWAP_LIMIT=1600m
BOT_MEMORY_RESERVATION=384m
BOT_PIDS_LIMIT=256
NAPCAT_MEMORY_LIMIT=400m
NAPCAT_MEMORY_SWAP_LIMIT=800m
NAPCAT_MEMORY_RESERVATION=192m
NAPCAT_PIDS_LIMIT=256

# Override this when you intentionally pin or upgrade NapCat.
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
